NODE_ENV=development
PORT=8787
STUDYSNAP_DATA_DIR=./data
APP_ORIGIN=http://localhost:5173
SESSION_DAYS=14

# Supabase browser client. Use the project URL and publishable key only.
# Never put a service_role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
DATA_ENCRYPTION_KEY=
# Set this to your first administrator account email before registering it.
ADMIN_EMAIL=admin@example.com

# Enables email-based account recovery, invitations, and due-date reminders.
RESEND_API_KEY=
EMAIL_FROM=StudySnap <hello@example.com>

# Google Classroom OAuth. Register /api/integrations/google/callback as a redirect URI.
# Classroom scopes are restricted to course and coursework reads.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/integrations/google/callback

# Stripe hosted subscription checkout. Configure webhook delivery before launch.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional external error collector webhook. Never put secrets in client-side VITE_* vars.
ERROR_WEBHOOK_URL=
